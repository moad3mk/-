[Unit]
Description=NEXO Cloud bot hosting panel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nexo
Group=nexo
WorkingDirectory=/opt/nexo
EnvironmentFile=/etc/nexo/nexo.env
Environment=NEXO_CGROUP_ROOT=/sys/fs/cgroup/system.slice/nexo-cloud.service
ExecStart=/usr/bin/node /opt/nexo/server.js
Restart=always
RestartSec=3

# Delegate CPU, memory and process controllers to NEXO so each bot gets
# its own cgroup v2 with enforceable resource limits.
Delegate=cpu memory pids
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=no
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
ProtectHostname=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Block private, loopback, link-local and metadata destinations for this service
# and all bot processes below it. Keep the local DNS stub reachable.
IPAddressDeny=10.0.0.0/8
IPAddressDeny=172.16.0.0/12
IPAddressDeny=192.168.0.0/16
IPAddressDeny=127.0.0.0/8
IPAddressDeny=169.254.0.0/16
IPAddressDeny=100.64.0.0/10
IPAddressDeny=::1/128
IPAddressDeny=fc00::/7
IPAddressDeny=fe80::/10
IPAddressAllow=127.0.0.53/32
IPAddressAllow=127.0.0.11/32
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/opt/nexo/bots

[Install]
WantedBy=multi-user.target
