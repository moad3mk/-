# Set a long, unique password before starting NEXO.
HOST_PASSWORD=replace-this-with-a-long-random-password

# Most hosting platforms provide PORT automatically.
PORT=3000

# Optional: keep bot data on a persistent mounted volume.
# NEXO_BOTS_DIR=/app/bots

# Keep these defaults unless the server has enough resources.
NEXO_MAX_RUNNING_BOTS=5
NEXO_MAX_BOTS=20

# Only set true behind exactly one trusted reverse proxy.
# TRUST_PROXY=true

# Required on Linux: delegated cgroup v2 directory from deploy/nexo-cloud.service.
# NEXO_CGROUP_ROOT=/sys/fs/cgroup/system.slice/nexo-cloud.service
# Per-bot hard limits (defaults: 512 MiB RAM, 50% of one CPU core, 64 processes).
NEXO_BOT_MEMORY_MAX=536870912
NEXO_BOT_CPU_PERCENT=50
NEXO_BOT_PIDS_MAX=64
